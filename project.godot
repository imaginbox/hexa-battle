; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="HexaBatlle"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Net="*res://scripts/network_manager.gd"
Lobby="*res://scripts/lobby_directory.gd"

[display]

window/size/viewport_width=1280.0
window/size/viewport_height=720.0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
viewport/hdr_2d=true
; Screen-space AA and TAA are Forward+ only — the engine logs a warning for each and
; does nothing with them on this renderer. 2D MSAA is likewise unsupported on GLES3.
; They were pure noise in the log and a false promise in the settings; 3D MSAA is the
; one that actually does something here, so it is the one that is kept.
anti_aliasing/quality/msaa_3d=1

[ziva]

multiplayer/user_id="OxU1IX8aGfwfWhxVyL1p0pOosn0gPhdR"
multiplayer/relay_url="wss://ziva-multiplayer.ziva-multiplayer.workers.dev"
multiplayer/game_id="b15b003f5023b15833c14b0373"
