# Godot 4+ specific ignores
.godot/
/android/

# Export output. CI builds it; nothing here belongs in the repository.
/build/

# Ziva's editor tooling. Roughly 1.5 Go of per-machine binaries that are not part of
# the game and are reinstalled on the machine that needs them — and GitHub rejects any
# single file over 100 Mo outright, which libcef.so alone (227 Mo) would trigger.
/addons/ziva_agent/

# Four AI-generated images that the game never references, in the scene or in code.
# They are also excluded from the export (see export_presets.cfg) so they do not cost
# anything on the download; this only keeps them out of the file listing.
/Assets/Gemini_Generated_Image_*.jpg
